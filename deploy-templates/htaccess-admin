# DECODE IT Solutions: .htaccess for the ADMIN folder ({{ADMIN_HOST}})
#   The admin lives at /admin and uses the API on {{MAIN_HOST}} (one database for all three addresses).
#   Any other page is sent to the main site.

Options -Indexes
DirectorySlash Off
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Always use HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Uploaded product photos and the API live on the main site
RewriteRule ^uploads/(.*)$ https://{{MAIN_HOST}}/uploads/$1 [L,R=302]
RewriteRule ^api(/.*)?$ https://{{MAIN_HOST}}/api$1 [L,R=307]

# 3. "/" opens the admin
RewriteRule ^$ https://{{ADMIN_HOST}}/admin [L,R=302]
RewriteRule ^admin(/.*)?$ app-shell.html [END]

# 4. Everything else that is not a real file belongs to the main site
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ https://{{MAIN_HOST}}%{REQUEST_URI} [L,R=301]
</IfModule>

<FilesMatch "^(README-DEPLOY\.txt|error_log|\..*|.*\.(sql|log|bak|zip))$">
  Require all denied
</FilesMatch>

# Security headers. The admin has no tracking scripts, so its Content-Security-Policy is strict: only this
# site's own code may run, and it may only talk to the API on {{MAIN_HOST}}. An injected script is blocked.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://{{MAIN_HOST}}; font-src 'self' data:; connect-src 'self' https://{{MAIN_HOST}}; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always unset X-Powered-By
  Header always set X-Robots-Tag "noindex, nofollow"
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain
</IfModule>
