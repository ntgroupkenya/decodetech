# DECODE IT Solutions: .htaccess for the site folder ({{SITE_HOST}})
#   /               the Shop            /product/...   product pages
#   /login /signup  customer accounts   /admin         the admin (strict security headers below)
#   /api            the PHP API         /uploads       product photos added in the admin

Options -Indexes
DirectorySlash Off
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Always use HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. {{ROOT_DOMAIN}} (without www) -> {{SITE_HOST}}
RewriteCond %{HTTP_HOST} ^{{ROOT_DOMAIN_RX}}(:[0-9]+)?$ [NC]
RewriteRule ^ https://{{SITE_HOST}}%{REQUEST_URI} [L,R=301]

# 3. The API and uploaded images (only image files are ever served from uploads/)
RewriteRule ^api(/.*)?$ api.php [L,QSA]
RewriteRule ^uploads/.+\.(jpe?g|png|webp|gif)$ - [NC,L]
RewriteRule ^uploads/ - [F]

# 4. The admin always gets the empty app shell (it is never pre-rendered)
RewriteRule ^admin(/.*)?$ app-shell.html [END]

# 5. Old addresses of the previous site go to the Shop
RewriteRule ^(shop|products|brands|about|contact|how-to-order|news|category)(/.*)?$ / [L,R=301]

# 6. Pre-rendered pages: /product/x/y -> product/x/y/index.html (no trailing slash)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*?)/?$ $1/index.html [L]

# 7. Anything else that is not a real file (login, sign-up, a product added after the last build)
#    gets the empty app shell, and the site shows the right page from the address
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ app-shell.html [L]
</IfModule>

# Never expose configuration or internal files (including any hidden file such as .user.ini)
<FilesMatch "^(config(\.local)?\.php|db\.php|router\.php|error_log|\..*|README-DEPLOY\.txt|.*\.(sql|log|bak|zip))$">
  Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HTTPS only for a year: browsers refuse a plain-HTTP (interceptable) connection to this address.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Other websites may not show these pages inside a frame (stops "clickjacking").
  Header always set X-Frame-Options "SAMEORIGIN"
  # No plugins, no <base> or form hijacking, and every request upgraded to HTTPS. Scripts are not restricted
  # further because Google Tag Manager loads tracking scripts chosen in its own dashboard.
  Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  # The site never needs the camera, microphone, location or payment APIs.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always unset X-Powered-By
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # The admin: no tracking scripts, so only this site's own code may run there (an injected script is blocked),
  # it may not be framed, and search engines are told to stay out.
  # THE_REQUEST is the browser's own request line, so this still matches after /admin is rewritten to app-shell.html.
  <If "%{THE_REQUEST} =~ m#^[A-Z]+ /admin(/|\?| |$)#">
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# Browser caching for images; pages are always re-checked so product changes show up
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml text/xml image/svg+xml text/plain
</IfModule>
